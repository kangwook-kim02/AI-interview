# 이 파일을 .env.local로 복사한 뒤 실제 값을 입력하세요.
# 실제 키는 이 예제 파일에 넣지 마세요.

# Supabase: 프로젝트 URL 및 Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: Secret key (sb_secret_...), 서버 관리자 작업이 필요할 때만 사용
# RLS를 우회하는 비밀 키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SECRET_KEY=

# LLM: 현재 구현은 openai. 다른 provider는 어댑터 추가 후 선택할 수 있습니다.
# 아래 설정과 API 키는 서버 전용입니다.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 선택: 비워 두면 src/config/ai.ts의 기본 모델(gpt-5.6-terra)을 사용합니다.
# Responses API 및 Structured Outputs를 지원하는 모델을 지정하세요.
LLM_MODEL=
